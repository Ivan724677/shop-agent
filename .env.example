# Never commit a real API key. Export these values in your shell instead.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Stage-seven service dependencies.
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
DEV_AUTH_ENABLED=true
OFFLINE_AGENT=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PENDING_ACTION_TTL_SECONDS=300
RAG_INDEX_ROOT=var/rag_indexes

# Optional production embedding service.
EMBEDDING_API_KEY=replace-with-your-embedding-key
EMBEDDING_BASE_URL=https://your-embedding-service/v1
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSION=1024
